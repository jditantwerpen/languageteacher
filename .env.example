# Copy to .env.local for local development, and set the same two
# variables in Netlify (Site configuration → Environment variables).
# Both values are on Supabase → Project Settings → API.
# The anon key is meant to be public; row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
